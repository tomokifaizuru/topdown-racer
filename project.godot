; Engine configuration file.
; Open this folder (project.godot) with Godot 4.5.x.

config_version=5

[application]

config/name="Topdown Racer"
config/description="Top-down 2D arcade racing prototype"
config/version="0.3"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.1, 0.11, 0.14, 1)
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/settings.gd"
Music="*res://scenes/music_player.tscn"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

